# AgentLedger — copy to .env and fill in secrets. NEVER commit .env.
# Backend (Go proxy, :8787)
PORT=8787
PRICES_FILE=data/prices.json
DATABASE_URL=postgres://agentledger:agentledger@localhost:5432/agentledger?sslmode=disable
AGENTLEDGER_VERSION=dev

# Upstream provider keys (at least one to proxy live traffic; empty = mock/smoke only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Optional upstream base-URL overrides
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=
DEEPSEEK_BASE_URL=
# Virtual keys: agents send vk_xxx; map here (format vk_a=sk-a,vk_b=sk-b)
VIRTUAL_KEYS=
# Management plane: dashboard server-side client for /v1/* (budgets/alerts/keys).
# PROXY_MGMT_BASE defaults to http://localhost:8787; set explicitly in Docker/prod.
PROXY_MGMT_BASE=http://localhost:8787
# Optional bearer gate for /v1/keys (proxy MGMT_TOKEN must match). Empty = open on localhost.
PROXY_MGMT_TOKEN=
MGMT_TOKEN=

# Phase 2 Saver (cache)
CACHE_ENABLED=true
CACHE_TTL_DEFAULT_SECS=3600
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_BODY_BYTES=1048576
CACHE_GUARD_ENABLED=true
EMBED_MODEL=all-MiniLM-L6-v2
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentledger_cache
QDRANT_API_KEY=
# Per-model/per-agent TTL overrides (seconds), e.g.:
# CACHE_TTL_MODEL_GPT_4O=7200
# CACHE_TTL_AGENT_SUPPORT_BOT=600

# Phase 3 Router
ROUTER_RULES_PATH=config/routing-rules.yaml
ROUTER_RULES_POLL_INTERVAL=5s
ROUTER_STRATEGY=balanced
ROUTER_PRICE_FEED_URL=
ROUTER_PRICE_POLL_INTERVAL=1h
ROUTER_QUALITY_THRESHOLD=0.6
ROUTER_ESCALATION_BUDGET=0.10
ROUTER_JUDGE_ENDPOINT=
ROUTER_ML_ENDPOINT=
ROUTER_BATCH_TAG=X-AgentLedger-Batch

# Phase 4 Enforcer
ENFORCER_MAX_DEPTH=50
ENFORCER_MAX_TOKENS=500000
ENFORCER_WINDOW_SECONDS=3600
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Phase 5 Brain (optional tuning; all have defaults)
BRAIN_LEARN_ALPHA=0.2
BRAIN_MAX_COMBOS=65536
BRAIN_ROI_SUCCESS_VALUE_USD=8.0

# Dashboard (Next.js)
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
